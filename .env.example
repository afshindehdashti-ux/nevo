# Public site URLs
APP_URL=https://nevoindustrial.com
SITE_URL=https://nevoindustrial.com
APP_ORIGIN=https://nevoindustrial.com
API_ALLOWED_ORIGINS=https://nevoindustrial.com,https://www.nevoindustrial.com

# Supabase browser/client access
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Supabase server access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_service_role_key_for_server_only

# One-time first-admin bootstrap.
# Required by POST /api/public/bootstrap-super-admin as x-bootstrap-token.
# Remove or rotate immediately after the first Super Admin exists.
NEVO_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-token

# Lovable integrations
LOVABLE_API_KEY=replace-with-lovable-api-key
LOVABLE_ASSET_ORIGIN=https://project--d4274815-117e-4165-b985-4a102b99aa9c.lovable.app

# Optional observability / external services
RESEND_API_KEY=re_your_server_only_resend_key
EMAIL_FROM=NEVO Industrial <noreply@notify.nevoindustrial.com>
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
